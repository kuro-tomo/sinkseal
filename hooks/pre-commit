#!/bin/bash
# SinkSeal version: 0.1.0
# SinkSeal pre-commit: gitleaks (lightweight, staged diff only) + R-flag scan
# Heavy checks (typecheck, tests) are deferred to pre-push so commits stay fast.

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Inside a worktree, .git is a file (a pointer to the real repo), not a
# directory, so a plain "$repo_root/.git/xxx" path silently fails (touch/rm just
# error out, so the marker never actually gets created and commit-msg's check
# quietly no-ops). --absolute-git-dir resolves the worktree's own real git
# directory (.git/worktrees/<name>), which works from both the main checkout and
# any worktree.
git_dir=$(git rev-parse --absolute-git-dir)
marker="$git_dir/FORGE_RFLAG_DETECTED"
remediation_marker="$git_dir/FORGE_OPEN_REMEDIATION_DETECTED"
rm -f "$marker" "$remediation_marker"

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --no-banner -v 2>&1; then
    echo ""
    echo "Blocked: gitleaks detected a probable secret."
    exit 1
  fi
else
  echo "Warning: gitleaks not found on PATH — secret scanning was skipped for this commit."
  echo "  Install it (https://github.com/gitleaks/gitleaks) so this check actually runs."
fi

rflag_rc=0
"$hook_dir/rflag-scan.sh" || rflag_rc=$?
if [ "$rflag_rc" -eq 1 ]; then
  touch "$marker"
  echo ""
  echo "This change was flagged as R-flag (risk-flag)."
  echo "Include one of these trailers at the end of your commit message:"
  echo "  R-Flag: yes"
  echo "  R-Flag: no (reason it doesn't apply)"
elif [ "$rflag_rc" -ne 0 ]; then
  # 0 = no flag, 1 = flagged; anything else means the scan could not run.
  # Unable to inspect is not a pass, and a trailer must not be able to wave it through.
  echo ""
  echo "Blocked: the R-flag scan failed to run (exit=${rflag_rc}). Unable to inspect is not a pass. See the output above."
  exit 1
fi

# Live-fire sink scan: exit 2 = hard block (refuse the commit), exit 1 = soft R-flag.
sink_rc=0
"$hook_dir/sink-scan.sh" || sink_rc=$?
if [ "$sink_rc" -eq 2 ]; then
  echo ""
  echo "Blocked: demo/mock code is calling a raw live-fire sink directly. Commit refused."
  echo "(If this is a genuinely intentional live-fire demo, register it in LIVE_FIRE.md first —"
  echo " see that file's template. Don't just bypass this check.)"
  exit 1
elif [ "$sink_rc" -eq 1 ]; then
  touch "$marker"
  echo ""
  echo "This change touches a live-fire sink (a raw outbound call site). R-flag trailer required."
  echo "Include one of these trailers at the end of your commit message:"
  echo "  R-Flag: yes"
  echo "  R-Flag: no (reason it doesn't apply)"
elif [ "$sink_rc" -ne 0 ]; then
  # 0 = no sink, 1 = soft R-flag, 2 = hard block; anything else (3 = could not
  # inspect, 127 = script missing, ...) means the scan could not run.
  echo ""
  echo "Blocked: the live-fire sink scan failed to run (exit=${sink_rc}). Unable to inspect is not a pass. See the output above."
  exit 1
fi

rem_rc=0
"$hook_dir/check-open-remediations.sh" || rem_rc=$?
if [ "$rem_rc" -eq 1 ]; then
  touch "$remediation_marker"
  echo ""
  echo "Include one of these trailers at the end of your commit message:"
  echo "  Remediation-Check: covered (this change addresses the open item)"
  echo "  Remediation-Check: unrelated (reason it doesn't apply)"
elif [ "$rem_rc" -ne 0 ]; then
  # 0 = no related item, 1 = possibly related; anything else means the check
  # could not run, which a trailer must not be able to wave through.
  echo ""
  echo "Blocked: the open-remediation check failed to run (exit=${rem_rc}). Unable to inspect is not a pass. See the output above."
  exit 1
fi

exit 0
